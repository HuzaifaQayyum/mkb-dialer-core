PORT=5000
HOST=0.0.0.0

# Asterisk ARI — this process holds the Stasis websocket
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=mkb_user
ASTERISK_ARI_PASSWORD=change-me
ASTERISK_STASIS_APP=mkb-dialer

# Laravel is the system of record for call state
LARAVEL_API_URL=http://127.0.0.1:8000/api

# Seconds to ring an agent before releasing the lead
AGENT_RING_TIMEOUT=25
ASTERISK_TRUNK=telnyx-trunk
TELNYX_SIP_DOMAIN=sip.telnyx.com

# Dev only: send outbound legs to a local echo instead of the carrier.
# Leave empty in any real environment.
ASTERISK_TEST_ENDPOINT=

RECORDING_ENABLED=true
RECORDING_FORMAT=wav
# Announcement played to the answering party before recording starts.
# Empty disables it — check your local consent laws before doing that.
RECORDING_NOTICE=sound:custom/recording-notice
